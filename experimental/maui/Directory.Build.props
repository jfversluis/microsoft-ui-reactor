<Project>
  <!--
    Deliberately does NOT import the repo-root Directory.Build.props: that file and
    its .targets sibling wire the Windows App SDK/WinUI build, which neither the
    renderer-neutral core nor the MAUI renderer may depend on. Everything under
    experimental/maui/ builds in isolation.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
