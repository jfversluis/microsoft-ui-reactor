<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renderer-neutral Reactor core: elements, components, hooks, reconciliation and
    scheduling. Plain net10.0 with no UI framework reference, so both the WinUI
    renderer (net10.0-windows) and the MAUI renderer (net11.0-*) can consume it.
    CoreBoundaryTests fails if a UI framework assembly ever becomes a dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.UI.Reactor.Core</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Core.Tests" />
  </ItemGroup>

</Project>
