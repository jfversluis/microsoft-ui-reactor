<Project>
  <!--
    Global usings for Reactor component code (applied when ImplicitUsings is on, as in MAUI apps):
    - the Reactor namespaces, so element types, modifiers such as .Margin() and .FontSize(), the
      hosts (ReactorWindow, ReactorPage), the app hooks, element refs (Microsoft.UI.Reactor.Input)
      and the direct renderer's setup are in scope
      wherever a file imports the factories with `using static Microsoft.UI.Reactor.Maui.Factories;`;
    - an Element alias: MAUI's implicit usings import Microsoft.Maui.Controls, which declares its
      own Element type, so a bare `Element` would be ambiguous. An alias outranks namespace imports.
    - a NavigationMode alias, for the same reason: Microsoft.Maui.ApplicationModel (also an implicit
      using) declares one, so a file importing Microsoft.UI.Reactor.Navigation would be ambiguous.
    Opt out with <ReactorImplicitUsings>false</ReactorImplicitUsings>.
  -->
  <ItemGroup Condition="'$(ReactorImplicitUsings)' != 'false'">
    <Using Include="Microsoft.UI.Reactor.Core" />
    <Using Include="Microsoft.UI.Reactor.Maui" />
    <Using Include="Microsoft.UI.Reactor.Maui.Hosting" />
    <Using Include="Microsoft.UI.Reactor.Maui.Direct" />
    <Using Include="Microsoft.UI.Reactor.Input" />
    <Using Include="Microsoft.UI.Reactor.Core.Element" Alias="Element" />
    <Using Include="Microsoft.UI.Reactor.Navigation.NavigationMode" Alias="NavigationMode" />
  </ItemGroup>
</Project>
