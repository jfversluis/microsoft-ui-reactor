<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Renderer-neutral Reactor core (spec 065): elements, components, hooks, reconciliation and
    scheduling. Plain net10.0 with no UI framework reference, so the MAUI renderer consumes it
    today and the WinUI renderer can later. CoreBoundaryTests fails if a UI framework assembly
    ever becomes a dependency.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Microsoft.UI.Reactor.Core</AssemblyName>
    <RootNamespace>Microsoft.UI.Reactor</RootNamespace>
    <PackageId>Microsoft.UI.Reactor.Core</PackageId>
    <Description>Renderer-neutral core of Reactor: components, hooks and keyed reconciliation.</Description>
    <PackageTags>Reactor;declarative;functional;reactive;components;hooks;MVU;UI</PackageTags>
  </PropertyGroup>

  <Import Project="..\Reactor.Maui.Packaging.props" />

  <ItemGroup>
    <InternalsVisibleTo Include="Reactor.Core.Tests" />
    <InternalsVisibleTo Include="Microsoft.UI.Reactor.Maui" />
    <InternalsVisibleTo Include="Reactor.Maui.Tests" />
  </ItemGroup>

</Project>
