<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Test code reflects by design and is never trimmed (see Directory.Build.targets). -->
    <ReactorSkipAotAnalysis>true</ReactorSkipAotAnalysis>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Microsoft.UI.Reactor.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <Using Include="Microsoft.UI.Reactor.Core.Element" Alias="Element" />
    <!-- These tests drive the engine through a fake renderer; MAUI's implicit usings would make
         its own IElementHandler ambiguous with the engine's. -->
    <Using Remove="Microsoft.Maui" />
    <Using Remove="Microsoft.Maui.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor.Maui\Reactor.Maui.csproj" />
  </ItemGroup>

</Project>
