<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Test code reflects by design and is never trimmed (see Directory.Build.targets). -->
    <ReactorSkipAotAnalysis>true</ReactorSkipAotAnalysis>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Microsoft.UI.Reactor.Core.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Reactor.Maui.Core\Reactor.Maui.Core.csproj" />
  </ItemGroup>

</Project>
